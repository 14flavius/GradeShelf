# Setup generates this secret. Keep it unchanged across updates and restores.
BETTER_AUTH_SECRET=

# Exact browser URL; use your public https:// domain behind a reverse proxy.
BETTER_AUTH_URL=http://localhost:3000

# Docker: host port, listen address and instance name.
# Use 0.0.0.0 for LAN access. Keep the instance name unchanged after setup.
PORT=3000
BIND_ADDRESS=127.0.0.1
COMPOSE_PROJECT_NAME=gradeshelf

# Optional: pin a release instead of using latest.
# GRADESHELF_IMAGE=ghcr.io/14flavius/gradeshelf:1.0.0

# Optional upload limits: MiB per file (1–100), files per entry (1–100).
# UPLOAD_MAX_FILE_MB=10
# UPLOAD_MAX_FILES_PER_ENTRY=10

# Attachment storage per user in GiB (0–1024); 0 = unlimited. Decimals allowed.
# UPLOAD_MAX_USER_GB=0

# Local Node.js development only. Docker mounts ./data at /data automatically.
DATA_DIR=./data

# Details and examples: README.md → Configuration.
# Apply Docker changes: docker compose up -d --pull never --wait
